# Copie para backend/.env e preencha sua chave localmente.
# Não publique backend/.env no GitHub.
GEMINI_API_KEY=insira
GEMINI_MODEL=gemini-3.5-flash-lite

# Configurações opcionais do banco (padrão: SQLite)
# USE_MYSQL=true
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=libelli

# A chave de sessão é gerada automaticamente se não for informada.
# Opcional: defina uma SECRET_KEY fixa para manter a sessão após reiniciar o Flask.
# SECRET_KEY=gere_uma_chave_aleatoria_forte
# false é o padrão para desenvolvimento em http://127.0.0.1.
# Em produção com HTTPS, use true.
SESSION_COOKIE_SECURE=false
